{
  "name": "railscope",
  "version": "0.0.0",
  "private": true,
  "description": "Rails の db/schema.rb をブラウザで ER 図化し、スキーマの地雷を lint する、サーバー送信なしの開発者向けツール。",
  "license": "MIT",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\""
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.30",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
